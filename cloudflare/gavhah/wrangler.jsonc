{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "gavhah-cloudflare-native",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "NODE_ENV": "production",
    "CF_WORKER_RUNTIME": "1"
  }
}
